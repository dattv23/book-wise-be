generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model User {
  id              String  @id @default(auto()) @map("_id") @db.ObjectId
  userId          Int     @unique @map("user_id")
  email           String  @unique
  password        String
  name            String
  phoneNumber     String? @map("phone_number")
  role            Role    @default(USER)
  isEmailVerified Boolean @default(false) @map("is_email_verified")

  orders   Order[]
  reviews  Review[]
  Wishlist Wishlist[]
  store    Store?
  Cart     Cart?

  isDeleted Boolean  @default(false) @map("is_deleted")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([role])
  @@map("users")
}

enum Role {
  USER
  STORE
  ADMIN
}

model Token {
  id          String    @id @default(auto()) @map("_id") @db.ObjectId
  token       String    @unique
  type        TokenType
  expires     DateTime
  blacklisted Boolean

  userId Int @map("user_id")

  isDeleted Boolean  @default(false) @map("is_deleted")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([userId])
  @@map("tokens")
}

enum TokenType {
  ACCESS
  REFRESH
  RESET_PASSWORD
  VERIFY_EMAIL
}

model Author {
  id       String @id @default(auto()) @map("_id") @db.ObjectId
  authorId Int    @unique @map("author_id")
  name     String
  slug     String @unique

  ProductAuthor ProductAuthor[]

  isDeleted Boolean  @default(false) @map("is_deleted")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@fulltext([name])
  @@map("authors")
}

model Category {
  id         String @id @default(auto()) @map("_id") @db.ObjectId
  categoryId Int    @unique @map("category_id")
  name       String
  slug       String @unique

  products Product[]

  isDeleted Boolean  @default(false) @map("is_deleted")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@fulltext([name])
  @@map("categories")
}

model Product {
  id            String @id @default(auto()) @map("_id") @db.ObjectId
  productId     Int    @unique @map("product_id")
  sku           String @unique
  name          String
  originalPrice Int    @map("original_price")
  discount      Int
  thumbnailUrl  String @map("thumbnail_url")
  stockQuantity Int    @map("stock_quantity")

  // Related data
  store   Store @relation(fields: [storeId], references: [storeId])
  storeId Int   @map("store_id")

  category   Category @relation(fields: [categoryId], references: [categoryId])
  categoryId Int      @map("category_id")

  details        ProductDetails?
  reviews        Review[]
  specifications Specification[]
  orderItems     OrderItem[]
  ProductAuthor  ProductAuthor[]
  Wishlist       Wishlist[]
  CartItem       CartItem[]

  isDeleted Boolean  @default(false) @map("is_deleted")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([storeId])
  @@index([categoryId])
  @@index([stockQuantity])
  @@index([storeId, categoryId])
  @@fulltext([name])
  @@map("products")
}

model ProductAuthor {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  product   Product @relation(fields: [productId], references: [productId], onDelete: Cascade)
  productId Int     @map("product_id")

  author   Author @relation(fields: [authorId], references: [authorId], onDelete: Cascade)
  authorId Int    @map("author_id")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([productId, authorId])
  @@index([productId])
  @@index([authorId])
  @@map("product_authors")
}

model ProductDetails {
  id               String   @id @default(auto()) @map("_id") @db.ObjectId
  shortDescription String?  @map("short_description")
  description      String?
  galleryImages    String[] @map("gallery_images")

  product   Product @relation(fields: [productId], references: [productId], onDelete: Cascade)
  productId Int     @unique @map("product_id")

  isDeleted Boolean  @default(false) @map("is_deleted")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("product_details")
}

model Review {
  id      String  @id @default(auto()) @map("_id") @db.ObjectId
  rating  Int     @map("rating") // Rating out of 5
  comment String? @map("comment")

  user   User @relation(fields: [userId], references: [userId])
  userId Int  @map("user_id")

  product   Product @relation(fields: [productId], references: [productId])
  productId Int     @map("product_id")

  isDeleted Boolean  @default(false) @map("is_deleted")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([productId])
  @@index([userId])
  @@map("reviews")
}

model Specification {
  id    String @id @default(auto()) @map("_id") @db.ObjectId
  name  String
  code  String
  value String

  product   Product @relation(fields: [productId], references: [productId], onDelete: Cascade)
  productId Int     @map("product_id")

  isDeleted Boolean  @default(false) @map("is_deleted")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([productId])
  @@map("specifications")
}

model Store {
  id      String  @id @default(auto()) @map("_id") @db.ObjectId
  storeId Int     @unique @map("store_id")
  name    String  @map("name")
  logo    String? @map("logo")
  link    String? @map("link")

  manager   User @relation(fields: [managerId], references: [userId], onDelete: Restrict)
  managerId Int  @unique @map("manager_id")

  products Product[]

  isDeleted Boolean  @default(false) @map("is_deleted")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@fulltext([name])
  @@map("stores")
}

model Order {
  id            String        @id @default(auto()) @map("_id") @db.ObjectId
  orderId       String        @unique @map("order_id")
  shippingFee   Int           @map("shipping_fee")
  totalAmount   Int           @map("total_amount")
  address       String
  phoneNumber   String        @map("phone_number")
  status        OrderStatus   @default(PENDING)
  paymentMethod PaymentMethod @map("payment_method")
  paymentStatus PaymentStatus @default(PENDING) @map("payment_status")

  user   User @relation(fields: [userId], references: [userId])
  userId Int  @map("user_id")

  items OrderItem[]

  isDeleted Boolean  @default(false) @map("is_deleted")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([userId])
  @@index([status])
  @@index([paymentStatus])
  @@index([createdAt])
  @@map("orders")
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
}

enum OrderStatus {
  PENDING
  SHIPPED
  DELIVERED
  COMPLETED
  CANCELED
}

enum PaymentMethod {
  COD
  VN_PAY
}

model OrderItem {
  id       String @id @default(auto()) @map("_id") @db.ObjectId
  quantity Int
  price    Int

  product   Product @relation(fields: [productId], references: [productId])
  productId Int     @map("product_id")

  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId String @map("order_id") @db.ObjectId

  @@index([orderId])
  @@index([productId])
  @@map("order_items")
}

model Cart {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  user   User @relation(fields: [userId], references: [userId])
  userId Int  @unique @map("user_id")

  items CartItem[]

  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("carts")
}

model CartItem {
  id       String @id @default(auto()) @map("_id") @db.ObjectId
  quantity Int

  cart   Cart   @relation(fields: [cartId], references: [id], onDelete: Cascade)
  cartId String @map("cart_id") @db.ObjectId

  product   Product @relation(fields: [productId], references: [productId])
  productId Int     @map("product_id")

  @@unique([cartId, productId])
  @@index([cartId])
  @@map("cart_items")
}

model Wishlist {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  user   User @relation(fields: [userId], references: [userId])
  userId Int  @map("user_id")

  product   Product @relation(fields: [productId], references: [productId])
  productId Int     @map("product_id")

  createdAt DateTime @default(now()) @map("created_at")

  @@unique([userId, productId])
  @@index([userId])
  @@map("wishlists")
}

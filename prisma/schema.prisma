generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model User {
  id              String  @id @default(auto()) @map("_id") @db.ObjectId
  email           String  @unique
  password        String
  name            String
  phoneNumber     String? @map("phone_number")
  role            Role    @default(USER)
  isEmailVerified Boolean @default(false) @map("is_email_verified")
  originalId      Int     @default(0) @map("original_id")

  orders   Order[]
  reviews  Review[]
  wishlist Wishlist[]
  store    Store?
  cart     Cart?
  tokens   Token[]

  isDeleted Boolean  @default(false) @map("is_deleted")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([role])
  @@map("users")
}

enum Role {
  USER
  STORE_MANAGER
  ADMIN
}

model Token {
  id          String    @id @default(auto()) @map("_id") @db.ObjectId
  token       String    @unique
  type        TokenType
  expires     DateTime
  blacklisted Boolean

  user   User   @relation(fields: [userId], references: [id])
  userId String @map("user_id") @db.ObjectId

  isDeleted Boolean  @default(false) @map("is_deleted")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([userId])
  @@index([expires])
  @@map("tokens")
}

enum TokenType {
  ACCESS
  REFRESH
  RESET_PASSWORD
  VERIFY_EMAIL
}

model Author {
  id         String @id @default(auto()) @map("_id") @db.ObjectId
  name       String
  slug       String
  originalId Int    @default(0) @map("original_id")

  products ProductAuthor[]

  isDeleted Boolean  @default(false) @map("is_deleted")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@fulltext([name])
  @@map("authors")
}

model Category {
  id         String @id @default(auto()) @map("_id") @db.ObjectId
  name       String
  slug       String @unique
  originalId Int    @default(0) @map("original_id")

  products Product[]

  isDeleted Boolean  @default(false) @map("is_deleted")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@fulltext([name])
  @@map("categories")
}

model Product {
  id               String   @id @default(auto()) @map("_id") @db.ObjectId
  sku              String   @unique
  name             String
  originalPrice    Int      @map("original_price")
  discount         Int
  thumbnailUrl     String   @map("thumbnail_url")
  stockQuantity    Int      @map("stock_quantity")
  shortDescription String?  @map("short_description")
  description      String?
  galleryImages    String[] @map("gallery_images")
  originalId       Int      @default(0) @map("original_id")

  // Related data
  store      Store    @relation(fields: [storeId], references: [id])
  storeId    String   @map("store_id") @db.ObjectId
  category   Category @relation(fields: [categoryId], references: [id])
  categoryId String   @map("category_id") @db.ObjectId

  reviews        Review[]
  specifications Specification[]
  orderItems     OrderItem[]
  authors        ProductAuthor[]
  wishlistItems  Wishlist[]
  cartItems      CartItem[]

  isDeleted Boolean  @default(false) @map("is_deleted")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([storeId])
  @@index([categoryId])
  @@index([stockQuantity])
  @@index([storeId, categoryId])
  @@fulltext([name])
  @@map("products")
}

model ProductAuthor {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId String  @map("product_id") @db.ObjectId

  author   Author @relation(fields: [authorId], references: [id], onDelete: Cascade)
  authorId String @map("author_id") @db.ObjectId

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([productId, authorId])
  @@index([productId])
  @@index([authorId])
  @@map("product_authors")
}

model Review {
  id      String  @id @default(auto()) @map("_id") @db.ObjectId
  rating  Int
  comment String?

  user      User    @relation(fields: [userId], references: [id])
  userId    String  @map("user_id") @db.ObjectId
  product   Product @relation(fields: [productId], references: [id])
  productId String  @map("product_id") @db.ObjectId

  isDeleted Boolean  @default(false) @map("is_deleted")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([productId])
  @@index([userId])
  @@map("reviews")
}

model Specification {
  id    String @id @default(auto()) @map("_id") @db.ObjectId
  name  String
  code  String
  value String

  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId String  @map("product_id") @db.ObjectId

  isDeleted Boolean  @default(false) @map("is_deleted")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([productId])
  @@map("specifications")
}

model Store {
  id         String  @id @default(auto()) @map("_id") @db.ObjectId
  name       String
  link       String?
  originalId Int     @default(0) @map("original_id")

  manager   User   @relation(fields: [managerId], references: [id], onDelete: Restrict)
  managerId String @unique @map("manager_id") @db.ObjectId

  products Product[]

  isDeleted Boolean  @default(false) @map("is_deleted")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@fulltext([name])
  @@map("stores")
}

model Order {
  id            String        @id @default(auto()) @map("_id") @db.ObjectId
  orderCode     String        @unique @map("order_code")
  shippingFee   Int           @map("shipping_fee")
  totalAmount   Int           @map("total_amount")
  address       String
  phoneNumber   String        @map("phone_number")
  status        OrderStatus   @default(PENDING)
  paymentMethod PaymentMethod @map("payment_method")
  paymentStatus PaymentStatus @default(PENDING) @map("payment_status")

  user   User   @relation(fields: [userId], references: [id])
  userId String @map("user_id") @db.ObjectId

  items OrderItem[]

  isDeleted Boolean  @default(false) @map("is_deleted")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([userId])
  @@index([status])
  @@index([paymentStatus])
  @@index([createdAt])
  @@map("orders")
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
}

enum OrderStatus {
  PENDING
  SHIPPED
  DELIVERED
  COMPLETED
  CANCELED
}

enum PaymentMethod {
  COD
  VN_PAY
}

model OrderItem {
  id       String @id @default(auto()) @map("_id") @db.ObjectId
  quantity Int
  price    Int

  product   Product @relation(fields: [productId], references: [id])
  productId String  @map("product_id") @db.ObjectId

  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId String @map("order_id") @db.ObjectId

  @@index([orderId])
  @@index([productId])
  @@map("order_items")
}

model Cart {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  user   User   @relation(fields: [userId], references: [id])
  userId String @unique @map("user_id") @db.ObjectId

  items CartItem[]

  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("carts")
}

model CartItem {
  id       String @id @default(auto()) @map("_id") @db.ObjectId
  quantity Int

  cart      Cart    @relation(fields: [cartId], references: [id], onDelete: Cascade)
  cartId    String  @map("cart_id") @db.ObjectId
  product   Product @relation(fields: [productId], references: [id])
  productId String  @map("product_id") @db.ObjectId

  @@unique([cartId, productId])
  @@index([cartId])
  @@map("cart_items")
}

model Wishlist {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  user      User    @relation(fields: [userId], references: [id])
  userId    String  @map("user_id") @db.ObjectId
  product   Product @relation(fields: [productId], references: [id])
  productId String  @map("product_id") @db.ObjectId

  createdAt DateTime @default(now()) @map("created_at")

  @@unique([userId, productId])
  @@index([userId])
  @@map("wishlists")
}
